# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (.env.example 은 커밋합니다)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Cloudflare
.wrangler/

# 로컬 작업 노트 (공유하지 않음) — docs/README.md 참고
docs/*
# 단, 서버 계약 문서는 팀이 함께 봐야 하므로 추적합니다.
# (`docs/` 가 아니라 `docs/*` 인 이유 — 디렉터리째 제외하면 git 이 안으로 들어가지 않아
#  아래 예외가 무시됩니다.)
!docs/openapi.yaml
!docs/api-integration.md

# generated native folders
/ios
/android
