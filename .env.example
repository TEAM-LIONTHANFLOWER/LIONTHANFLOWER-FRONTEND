# 이 파일을 .env 로 복사한 뒤 값을 채워주세요. (.env 는 커밋하지 않습니다)
# Expo 는 EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트 번들에 주입합니다.
# 빌드 시점에 그대로 인라인되므로 비밀키는 절대 넣지 마세요.

# 개발 서버. 경로에 /api 가 이미 들어 있으므로 호스트까지만 적습니다.
EXPO_PUBLIC_API_BASE_URL=https://mcmorbit.p-e.kr

# 직원 로그인이 보낼 근무 매장 UUID.
# 매장 검색·목록 API 가 아직 없어 임시로 여기서 읽습니다. 값이 없으면 직원 로그인이 막힙니다.
EXPO_PUBLIC_DEFAULT_STORE_ID=
